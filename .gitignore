# DSH Kxxy — 忽略规则

# ---- Android 构建产物 ----
.gradle/
build/
local.properties
*.iml
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/
# Gradle/JVM 崩溃日志：本机内存只有 7.8 GB，构建期 OOM 时会落在 android/ 下，
# 内容是堆栈快照而非源码，不入库
hs_err_pid*.log
replay_pid*.log

# ---- 运行时装配产物 ----
# runtime.zip 是 tools/build-runtime.mjs 的产物（④ 全能精选档 497 MiB / 35250 条目），
# 由本机 DSH 桌面版的 app.asar + Termux .deb 装配而成，不属于源码。
# 需要它的人请按 README「三、构建」自行生成。
android/app/src/main/assets/runtime.zip

# 扩展包池（tools/fetch-extensions.mjs 产物，约 1.0 GiB / 20 项），与 runtime.zip
# 同理是构建产物；目录清单随包生成于 plugins/kxxy-host/extensions.json。
android/app/src/main/assets/ext-pool/
plugins/kxxy-host/extensions.json

# 官方主题 token（构建期抽取产物，见 tools/build-runtime.mjs extractOfficialTheme）
plugins/kxxy-host/web/theme.css

# ---- 装配中间缓存 ----
# .cache/debs（下载的 .deb）与 .cache/stage（解包后的 Termux 前缀树），
# 可由 tools/fetch-runtime.mjs 重新拉取，体积约 226 MiB。
.cache/
